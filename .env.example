# Copying this file is optional; `make configure` creates a private .env safely.
# Never commit .env. The wizard writes it atomically with mode 0600.

WAYANG_HOST="127.0.0.1"
WAYANG_PORT="8787"
# Exact browser-facing origin for a reverse proxy or non-loopback deployment.
# Loopback-only use defaults securely when this remains unset.
# WAYANG_PUBLIC_ORIGIN="https://wayang.example"
# WAYANG_DATA_DIR="/absolute/path/to/private/wayang-data"
# WAYANG_URL="http://127.0.0.1:8787"  # Optional companion pi tools only.

# Optional built-in shared-password login. Use `make configure`; do not create
# hashes or session secrets by hand.
WAYANG_AUTH_ENABLED="0"
WAYANG_TRUST_PROXY="loopback"
# Optional stable identity header injected only by an authenticated loopback
# reverse proxy. Configure through `make configure`; never forward a client value.
# WAYANG_AUTH_PROXY_IDENTITY_HEADER="x-authentik-uid"
WAYANG_AUTH_COOKIE_SECURE="auto"
WAYANG_AUTH_SESSION_DAYS="30"
# WAYANG_AUTH_PASSWORD_HASH="generated-by-make-configure"
# WAYANG_AUTH_SESSION_SECRET="generated-by-make-configure"

# Optional connector-neutral messaging gateway with Matrix Application Service
# as its first adapter. Disabled startup does not open the private file. When
# enabled, the exact versioned JSON must be an absolute canonical owner-only
# mode-0600 regular file; it contains reviewed endpoint declarations and opaque
# Matrix tokens. Never place token values in .env, source, argv, or logs.
WAYANG_MESSAGING_ENABLED="0"
# WAYANG_MESSAGING_CONFIG_PATH="/absolute/private/messaging.json"

# Optional backend-owned restricted-profile MCP grant policy. The referenced
# JSON contains reviewed server/tool metadata and launcher paths, never
# credential values. It must be an absolute, owner-only mode-0600 regular file.
# WAYANG_RESTRICTED_MCP_CONFIG_PATH="/absolute/path/to/restricted-mcp.json"

# Choose one provider API key, or use `make pi-login` for OAuth/API-key login.
# ANTHROPIC_API_KEY="enter-locally-with-make-configure"
# OPENAI_API_KEY="enter-locally-with-make-configure"
# OPENROUTER_API_KEY="enter-locally-with-make-configure"
# GEMINI_API_KEY="enter-locally-with-make-configure"
# DEEPSEEK_API_KEY="enter-locally-with-make-configure"

# Optional one-time Terra session titles after three completed interactive
# exchanges. Enabling discloses bounded first-three user/assistant prose to
# openai-codex/gpt-5.6-terra. Protected Projects require both flags.
WAYANG_AUTO_SESSION_TITLE="off"
WAYANG_AUTO_SESSION_TITLE_PROTECTED="off"

# Disabled-by-default complete A/B/C file-audio experiment. Enabling this flag
# is insufficient by itself: the reviewed direct-audio, local DSP, and isolated
# gpt-5.6-sol composition must also be installed. Exact Wren + Standard +
# interactive sessions only; preview/execute/revoke are same-current-turn.
WAYANG_FILE_AUDIO_EXPERIMENT_ENABLED="0"
# WAYANG_FILE_AUDIO_EXPERIMENT_PERMIT_TTL_MS="60000"
# Absolute owner-private prompt files. Contents never belong in .env/source.
# WAYANG_FILE_AUDIO_EXPERIMENT_WREN_CAPSULE_PATH="/absolute/private/wren-capsule.txt"
# Frozen lowercase SHA-256 of the exact capsule bytes.
# WAYANG_FILE_AUDIO_EXPERIMENT_WREN_CAPSULE_SHA256="set-after-private-review"
# WAYANG_FILE_AUDIO_EXPERIMENT_SHARED_TASK_PATH="/absolute/private/shared-task.txt"
# WAYANG_FILE_AUDIO_EXPERIMENT_SHARED_TASK_SHA256="set-after-private-review"
# WAYANG_FILE_AUDIO_EXPERIMENT_NEUTRAL_ADAPTER_PATH="/absolute/private/neutral-adapter.txt"
# WAYANG_FILE_AUDIO_EXPERIMENT_NEUTRAL_ADAPTER_SHA256="set-after-private-review"
# WAYANG_FILE_AUDIO_EXPERIMENT_RESPONSE_SCHEMA_PATH="/absolute/private/response-schema.txt"
# WAYANG_FILE_AUDIO_EXPERIMENT_RESPONSE_SCHEMA_SHA256="set-after-private-review"
# WAYANG_FILE_AUDIO_EXPERIMENT_SOL_SYNTHESIS_PROMPT_PATH="/absolute/private/sol-synthesis.txt"
# WAYANG_FILE_AUDIO_EXPERIMENT_SOL_SYNTHESIS_PROMPT_SHA256="set-after-private-review"
# All five paths must be distinct. Hashes freeze the exact reviewed bytes.
# Sol prompt/schema and DSP PNGs stay inside isolated synthesis; they are not
# released to the ordinary outer model.
# Optional private temporary root and canonical Linux executable selectors.
# The built-in runner fails closed unless /usr/bin/prlimit, /usr/bin/bwrap, and
# absolute canonical ffmpeg/ffprobe paths are available; media processes have
# bounded native resources and no host network/home.
# WAYANG_FILE_AUDIO_EXPERIMENT_MEDIA_TEMP_ROOT="/absolute/private/audio-temp"
# WAYANG_FILE_AUDIO_EXPERIMENT_FFMPEG_PATH="/usr/bin/ffmpeg"
# WAYANG_FILE_AUDIO_EXPERIMENT_FFPROBE_PATH="/usr/bin/ffprobe"

# Startup-immutable Standard Browser Profile host gate. M0 defaults inert;
# enabling it fails production startup until full host/schema composition lands.
# Enables the reviewed schema-6 named Standard Browser Profile host/workspace stack.
# Keep disabled until the matching backend/frontend build and migration are staged together.
WAYANG_STANDARD_BROWSER_PROFILE_HOSTS="0"

# Optional embedded browser. Auto-detected when possible. `auto` prefers the
# full VNC viewer when available; `cdp` selects the fast page viewer.
# WAYANG_CHROMIUM_PATH="/absolute/path/to/chromium"
# WAYANG_BROWSER_TRANSPORT="auto"
# WAYANG_BITWARDEN_CLI_PATH="/absolute/path/to/bw"
# WAYANG_BROWSER_CREDENTIALS_IDLE_MINUTES="15"

# Optional text-to-speech broker (preferred) or direct Chatterbox fallback.
# WAYANG_TTS_BROKER_URL="http://127.0.0.1:8200"
# WAYANG_TTS_BASE_URL="http://127.0.0.1:8100"
# WAYANG_TTS_VOICE="Ava.mp3"
# WAYANG_TTS_MODEL="chatterbox-turbo"
# WAYANG_TTS_FORMAT="mp3"
# WAYANG_TTS_SPEED="1.0"
# WAYANG_TTS_MAX_CHARS="500"
