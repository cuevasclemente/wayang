{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "resolveJsonModule": true,
    "paths": {
      "@wayang/protocol": ["../packages/protocol/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "references": [{ "path": "../packages/protocol" }]
}
